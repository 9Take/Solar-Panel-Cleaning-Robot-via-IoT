# Dashboard-only settings. Copy to dashboard/.env and fill in. Never commit .env.
# Gateway settings (HISTORY_DB, SCHEDULE_TZ, PLC_TAGS_FILE) are read from the repo's .env.

# --- Weather (Open-Meteo, free, no API key) ---
# Location of the solar panels (decimal degrees). Leave empty to show simulated weather
# Site: I NOW Co., Ltd., Na Mai, Lat Lum Kaeo, Pathum Thani 12140 (from the owner's Google Maps link)
WEATHER_LAT=14.0620
WEATHER_LON=100.3334
# Name shown next to the weather, e.g. the site name
WEATHER_PLACE=I NOW CO.,LTD. ต.หน้าไม้ อ.ลาดหลุมแก้ว ปทุมธานี
# How often to ask Open-Meteo (seconds)
WEATHER_REFRESH_S=600
