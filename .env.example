# Copy to .env and fill in real values. Never commit .env.
# Keep comments on their own lines (inline comments are not portable across parsers).

# --- PLC (Delta DVP-12SE11T, Modbus TCP) ---
# PLC IP address (use plc-sim when running the mock PLC)
PLC_HOST=192.168.1.5
# Modbus TCP port
PLC_PORT=502
# Modbus unit/slave ID
PLC_UNIT_ID=1
# Request timeout (seconds)
PLC_TIMEOUT_S=2.0
# Status polling interval (seconds)
PLC_POLL_INTERVAL_S=1.0

# --- Mock PLC (python -m app.sim / compose profile "sim") ---
# Bind address of the mock PLC server
SIM_HOST=0.0.0.0
# Port 502 works in Docker; outside Docker use e.g. 5020 (ports < 1024 need root)
SIM_PORT=502
# Simulate the robot (ladder + plant). false = static datastore only
SIM_BEHAVIOR=true
# Simulation step (seconds) and simulated end-to-end travel time (seconds)
SIM_TICK_S=0.2
SIM_TRAVEL_S=20
# Mock feeds battery_pct + pi_heartbeat itself. Set false when the gateway's Tuya battery feed is on
# (both writing the same registers would hide a dead feed)
SIM_FAKE_PI_BATTERY=true

# --- Tag map ---
PLC_TAGS_FILE=config/plc_tags.yaml

# --- Tuya Cloud API: battery % from the MPPT solar controller ---
# Leave any of the five below empty to disable the battery feed (no battery_pct / pi_heartbeat writes)
# From Tuya IoT Platform > Cloud project > Overview
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
# Data center of the Tuya project, e.g. https://openapi.tuyaeu.com (EU), https://openapi.tuyaus.com (US), https://openapi.tuyacn.com (CN)
TUYA_API_ENDPOINT=
TUYA_DEVICE_ID=
# DP code holding battery %; list the device's DPs with: python -m app.tuya
TUYA_BATTERY_DP=
# battery % = DP value * scale (e.g. 0.1 if the DP reports 0-1000)
TUYA_BATTERY_SCALE=1
# HTTP timeout and how often to ask Tuya (seconds; mind the API quota)
TUYA_TIMEOUT_S=10
TUYA_POLL_INTERVAL_S=60
# A Tuya reading older than this is not fed; the heartbeat stops and the PLC treats the battery as unknown
BATTERY_MAX_AGE_S=300
# How often the Pi writes battery_pct + pi_heartbeat (the ladder's timeout is 10 s)
PI_HEARTBEAT_INTERVAL_S=2

# --- API / dashboard (future, optional) ---
API_KEY=
API_SECRET=

# --- Schedule (timed cleaning runs, Auto mode) ---
# Time zone of schedule times; manage runs with: python -m app.schedule
SCHEDULE_TZ=Asia/Bangkok

# --- History (SQLite) ---
# Live values, snapshots and events for the dashboard
HISTORY_DB=logs/gateway.db
# Store all tag values every N seconds; delete snapshots older than N days (events are kept)
SNAPSHOT_INTERVAL_S=10
HISTORY_RETENTION_DAYS=30

# --- Logging ---
LOG_DIR=logs
LOG_LEVEL=INFO
