# Copy to .env and fill in real values. Never commit .env.

# --- PLC (Delta DVP-12SE11T, Modbus TCP) ---
PLC_HOST=192.168.1.10        # PLC IP address
PLC_PORT=502                 # Modbus TCP port
PLC_UNIT_ID=1                # Modbus unit/slave ID
PLC_TIMEOUT_S=2.0            # Request timeout (seconds)
PLC_POLL_INTERVAL_S=1.0      # Status polling interval (seconds)

# --- Tag map ---
PLC_TAGS_FILE=config/plc_tags.yaml

# --- API / dashboard (future) ---
API_KEY=change-me
API_SECRET=change-me

# --- Logging ---
LOG_DIR=logs
LOG_LEVEL=INFO
